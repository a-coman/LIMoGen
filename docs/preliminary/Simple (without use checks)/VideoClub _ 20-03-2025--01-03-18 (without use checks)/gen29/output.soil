!series30.episode := 7

!new Actor('actor58')
!actor58.name := 'Explorer Adventurer'

!new Actor('actor59')
!actor59.name := 'Documentary Host'

!insert (client31, rental31) into ClientRental
!insert (rental31, movie31) into RentalCassette
